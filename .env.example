# Developer configuration only. Copy to .env.local (ignored by Git).
# Google Cloud > OAuth client > Desktop app; enable YouTube Data API v3.
STREAMER_ASSIST_GOOGLE_CLIENT_ID=
STREAMER_ASSIST_GOOGLE_CLIENT_SECRET=
# This public application ID is not a user's access token.
# Keep the Desktop client secret in .env.local; never send it in chat.
# Installed apps cannot keep a bundled client secret confidential.
# For packaged apps set youtubeClientId in electron/oauth-config.json.
# CHZZK public chat requires only a channel URL, without developer credentials.
