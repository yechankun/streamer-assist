{
  "name": "streamer-assist",
  "version": "0.1.0",
  "description": "Lightweight streaming timeline, highlights and cross-platform polls",
  "author": "yechankun",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "npm run build && electron tests/desktop-smoke.cjs",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "parseuri": "file:./vendor/streamer-assist-uri-parser-1.0.0.tgz",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io-client": "2.0.3"
  },
  "overrides": {
    "engine.io-client": "3.5.6",
    "socket.io-parser": "3.3.6",
    "ws": "5.2.7",
    "xmlhttprequest-ssl": "1.6.3",
    "parseuri": "$parseuri"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wait-on": "^9.0.0"
  },
  "build": {
    "appId": "com.yechankun.streamerassist",
    "productName": "Streamer Assist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "vendor/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "artifactName": "Streamer-Assist-${version}-${arch}-Setup.${ext}"
  }
}
