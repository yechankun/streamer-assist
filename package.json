{
  "name": "streamer-assist",
  "version": "0.3.0",
  "description": "Lightweight streaming timeline, highlights and cross-platform polls",
  "author": "yechankun",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:tools": "node scripts/dev.cjs --devtools",
    "dev:stop": "node scripts/dev.cjs --stop",
    "build": "node scripts/build.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node scripts/test-desktop.cjs --build",
    "start": "electron .",
    "dist": "npm run build && node scripts/package.cjs --nsis",
    "dist:msix": "npm run build && node scripts/package.cjs --msix",
    "dist:all": "npm run build && node scripts/package.cjs --all",
    "verify:msix": "powershell -NoProfile -File scripts/verify-msix.ps1",
    "docs": "node scripts/generate-docs.cjs",
    "docs:screenshots": "node scripts/capture-docs.cjs",
    "test:desktop:built": "node scripts/test-desktop.cjs",
    "dist:all:built": "node scripts/package.cjs --all",
    "benchmark:timeline": "node scripts/benchmark-timeline.cjs",
    "docs:screenshots:store": "node scripts/capture-docs.cjs --store",
    "docs:check": "node scripts/check-docs.cjs"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wait-on": "^9.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "build": {
    "appId": "com.yechankun.streamerassist",
    "productName": "Streamer Assist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "artifactName": "Streamer-Assist-${version}-${arch}-Setup.${ext}"
  }
}
